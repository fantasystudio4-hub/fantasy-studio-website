rules_version = '2';
// ============================================================================
// FANTASY STUDIO — FIREBASE STORAGE RULES (portfolio, 6 Oct 2026)
// Firebase console → Storage → Rules → paste → Publish.
// Only the owner uploads or deletes. Nobody reads through the Storage API:
// the pictures and films reach approved clients as download links held in
// Firestore's portfolio/ docs, which only approved logins can read.
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['fantasystudio4@gmail.com']
        // the address alone is only a claim: a password or email-link account,
        // or an email added to a phone account, can carry it unverified. The
        // admin signs in with Google, so require exactly that.
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /portfolio/{file} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && ((request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024)
         || (request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024));
      allow delete: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
