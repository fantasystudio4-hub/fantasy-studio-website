rules_version = '2';
// ============================================================================
// FANTASY STUDIO — COMBINED FIRESTORE RULES (studio site + LensCal)
// A database has ONE rules document, so the LensCal collections MUST live here
// too — otherwise publishing this locks LensCal's crew out of their own app.
// Paste the whole file into: Firebase console → Firestore Database → Rules →
// Publish. It applies server-side immediately; there is no git deploy.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // you, signed in to the admin panel
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['fantasystudio4@gmail.com'];
    }

    // last 10 characters of the signed-in client's verified phone number.
    // The E.164 token (e.g. "+918686868803" or NRI "+447911123456") includes a
    // leading '+', so the last 10 chars strip it and the country code down to
    // the stored "last 10 digits" key — works for +91 AND overseas clients.
    function clientPhone10() {
      return (request.auth != null
              && request.auth.token.phone_number is string
              && request.auth.token.phone_number.size() >= 11)
        ? request.auth.token.phone_number[
            (request.auth.token.phone_number.size() - 10):
             request.auth.token.phone_number.size()]
        : '__none__';
    }

    // visitors may only CREATE leads — never read, change or delete them.
    // Pinned to the exact fields the form sends, with size caps, so a stranger
    // cannot inject extra/oversized fields into your admin console.
    match /leads/{leadId} {
      allow create:
        if request.resource.data.keys().hasOnly(
             ['name','phone','phoneFull','eventType','weddingDate',
              'message','quote','grandTotal','source','createdAt','status','notes'])
        && request.resource.data.status == 'new'
        && request.resource.data.notes == ''
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.source in ['package_builder', 'contact_form'];
      allow read, update, delete: if isAdmin();
    }

    // visitors may READ the site config; only you may write it
    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // quote-number counter — admin only
    match /config/counters {
      allow read, write: if isAdmin();
    }

    // packages: you get full access; a signed-in client may READ only the
    // packages saved under their own verified mobile number (any country code)
    match /packages/{pkgId} {
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.clientPhone == clientPhone10());
      allow write: if isAdmin();
    }

    // hashed phone index — single-doc existence check before sending an OTP
    match /phoneIndex/{h} {
      allow get:   if true;
      allow list:  if false;    // never allow enumerating the whole index
      allow write: if isAdmin();
    }

    // ---- LensCal (shares this project — these MUST stay or LensCal breaks) --
    match /lenscal_users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
    match /lenscal_availability/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && docId.split('_')[0] == request.auth.uid
                   && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && docId.split('_')[0] == request.auth.uid;
    }
    match /lenscal_connections/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.users;
    }
    match /lenscal_groups/{groupId} {
      allow read, update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
    }
    match /lenscal_broadcasts/{id} {
      allow read: if request.auth != null
                  && (resource.data.by == request.auth.uid
                      || request.auth.uid in resource.data.to);
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.by == request.auth.uid
                        || (request.auth.uid in resource.data.to
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['responders'])));
      allow delete: if request.auth != null && resource.data.by == request.auth.uid;
    }

    // everything else: admin only (default deny for non-admins)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
