rules_version = '2';
// ============================================================================
// FANTASY STUDIO — FIRESTORE RULES
// Paste the whole file into: Firebase console → Firestore Database → Rules →
// Publish. It applies server-side immediately; there is no git deploy.
// (LensCal was removed from this project in Jul 2026 — its lenscal_*
// collections now fall under the final default-deny match, i.e. admin-only.)
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // you, signed in to the admin panel
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['fantasystudio4@gmail.com'];
    }

    // last 10 characters of the signed-in user's verified phone number —
    // used for clients (packages) AND crew (team/assignments/teamRequests).
    // The E.164 token (e.g. "+918686868803" or NRI "+447911123456") includes a
    // leading '+', so the last 10 chars strip it and the country code down to
    // the stored "last 10 digits" key — works for +91 AND overseas clients.
    function clientPhone10() {
      return (request.auth != null
              && request.auth.token.phone_number is string
              && request.auth.token.phone_number.size() >= 11)
        ? request.auth.token.phone_number[
            (request.auth.token.phone_number.size() - 10):
             request.auth.token.phone_number.size()]
        : '__none__';
    }

    // visitors may only CREATE leads — never read, change or delete them.
    // Pinned to the exact fields the form sends, with size caps, so a stranger
    // cannot inject extra/oversized fields into your admin console.
    match /leads/{leadId} {
      allow create:
        if request.resource.data.keys().hasOnly(
             ['name','phone','phoneFull','eventType','weddingDate',
              'message','quote','grandTotal','source','createdAt','status','notes'])
        && request.resource.data.status == 'new'
        && request.resource.data.notes == ''
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.source in ['package_builder', 'contact_form'];
      allow read, update, delete: if isAdmin();
    }

    // visitors may READ the site config; only you may write it
    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // quote-number counter — admin only
    match /config/counters {
      allow read, write: if isAdmin();
    }

    // packages: you get full access; a signed-in client may READ only the
    // packages saved under their own verified mobile number (any country code)
    match /packages/{pkgId} {
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.clientPhone == clientPhone10());
      allow write: if isAdmin();
    }

    // hashed phone index — single-doc existence check before sending an OTP
    match /phoneIndex/{h} {
      allow get:   if true;
      allow list:  if false;    // never allow enumerating the whole index
      allow write: if isAdmin();
    }

    // team members — created and managed only by the admin (approving a crew
    // request just means the admin creates this doc). A signed-in crew member
    // reads their own card via  where('phone10','==', <their last-10>)  —
    // the rules engine only permits queries whose filter provably satisfies
    // the phone match, so nobody can enumerate the team (same proven pattern
    // as the packages/clientPhone rule above).
    match /team/{memberId} {
      allow read: if isAdmin() || resource.data.phone10 == clientPhone10();
      allow create, update, delete: if isAdmin();
    }

    // per-member per-event assignments (schedule + pay). A crew member can
    // read ONLY their own docs, and the ONLY write they can ever make is
    // flipping status to 'acknowledged' (+ the server-time ack stamp) on
    // their own doc — never pay, never dates, never anyone else's.
    match /assignments/{assignId} {
      allow read: if isAdmin() || resource.data.memberPhone10 == clientPhone10();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.memberPhone10 == clientPhone10()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status','ackAt'])
            && request.resource.data.status == 'acknowledged'
            && request.resource.data.ackAt == request.time);
    }

    // join requests from the crew page. One per signed-in account (doc id is
    // the auth uid), the phone is pinned to the OTP-verified number, and the
    // fields are pinned + size-capped so nothing arbitrary can be injected
    // into the admin console. Only the admin can approve/dismiss (update/
    // delete); the requester can re-read their own request to see it pending.
    match /teamRequests/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && clientPhone10() != '__none__'
        && request.resource.data.keys().hasOnly(
             ['name','note','phone10','phoneFull','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.phone10 == clientPhone10()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.phoneFull is string
        && request.resource.data.phoneFull.size() <= 20;
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, update, delete: if isAdmin();
    }

    // everything else (incl. legacy lenscal_* data): admin only — default deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
