rules_version = '2';
// ============================================================================
// FANTASY STUDIO — FIRESTORE RULES
// Paste the whole file into: Firebase console → Firestore Database → Rules →
// Publish. It applies server-side immediately; there is no git deploy.
// (LensCal was removed from this project in Jul 2026 — its lenscal_*
// collections now fall under the final default-deny match, i.e. admin-only.)
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // you, signed in to the admin panel
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['fantasystudio4@gmail.com'];
    }

    // last 10 characters of the signed-in user's verified phone number —
    // used for clients (packages) AND crew (team/assignments/editingJobs).
    // The E.164 token (e.g. "+918686868803" or NRI "+447911123456") includes a
    // leading '+', so the last 10 chars strip it and the country code down to
    // the stored "last 10 digits" key — works for +91 AND overseas clients.
    function clientPhone10() {
      return (request.auth != null
              && request.auth.token.phone_number is string
              && request.auth.token.phone_number.size() >= 11)
        ? request.auth.token.phone_number[
            (request.auth.token.phone_number.size() - 10):
             request.auth.token.phone_number.size()]
        : '__none__';
    }

    // visitors may only CREATE leads — never read, change or delete them.
    // Pinned to the exact fields the form sends, with size caps, so a stranger
    // cannot inject extra/oversized fields into your admin console.
    //
    // hasOnly() only says WHICH keys may appear. Five of them — phoneFull,
    // eventType, weddingDate, quote, grandTotal — had no type or size check at
    // all, so anyone holding the public web API key could put a megabyte of
    // anything in them, or a string where the panel expected a number. That is
    // how a lead field ended up rendering as markup in the signed-in admin
    // session. Every field is now typed and bounded, and `quote` is pinned to
    // its own three keys with a numeric sheet count.
    //
    // Two more fields were still free: createdAt and the entries of
    // quote.events. The panel sorts the lead list by createdAt and calls
    // .toDate() on it, and walks every event to print the quote — so one
    // anonymous lead carrying createdAt as a map ({toDate: 1}), or a null in
    // its events, threw inside the stats render and blanked the Leads, Home
    // and Calendar screens for the signed-in owner. The panel now cleans each
    // lead as it reads it (cleanLead), but a lead that can never be stored
    // wrong is the better fix: createdAt must be a real timestamp (which
    // also makes it required), and every event that exists must be a map.
    // The public web form writes the client clock, not the server's
    // (REST cannot ask for serverTimestamp()), so it is NOT pinned to
    // request.time and has no bound either way: a phone with a wrong clock
    // is still a real enquiry. Only the type is checked.
    //
    // ONE `is map` per slot, on purpose. leadEventAt(l, n) checks entry n
    // when the list is long enough and passes when it is not — rules have no
    // loops, but they can index — and leadEventsOk calls it for 0…11, every
    // entry the 12-cap below allows. Anything heavier per entry (typing the
    // services inside it, say) exhausts the 1000-expression budget and
    // refuses a perfectly valid 12-function quote.
    function leadField(k, dflt) {
      return request.resource.data.get(k, dflt);
    }
    match /leads/{leadId} {
      function leadEventAt(l, n) {
        return l.size() <= n || l[n] is map;
      }
      function leadEventsOk(l) {
        return leadEventAt(l, 0)
          && leadEventAt(l, 1)
          && leadEventAt(l, 2)
          && leadEventAt(l, 3)
          && leadEventAt(l, 4)
          && leadEventAt(l, 5)
          && leadEventAt(l, 6)
          && leadEventAt(l, 7)
          && leadEventAt(l, 8)
          && leadEventAt(l, 9)
          && leadEventAt(l, 10)
          && leadEventAt(l, 11);
      }
      allow create:
        if request.resource.data.keys().hasOnly(
             ['name','phone','phoneFull','eventType','weddingDate',
              'message','quote','grandTotal','source','createdAt','status','notes'])
        && request.resource.data.status == 'new'
        && request.resource.data.notes == ''
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.source in ['package_builder', 'contact_form']
        && request.resource.data.createdAt is timestamp
        // the five that used to be unchecked
        && leadField('phoneFull', '') is string
        && leadField('phoneFull', '').size() <= 20
        && leadField('eventType', '') is string
        && leadField('eventType', '').size() <= 200
        && leadField('weddingDate', '') is string
        && leadField('weddingDate', '').size() <= 10
        && (leadField('grandTotal', 0) == null || leadField('grandTotal', 0) is number)
        // the contact form sends quote: null; the builder sends this exact shape
        && (leadField('quote', null) == null || (
              leadField('quote', null) is map
              && request.resource.data.quote.keys().hasOnly(['events','albumSheets','promo'])
              && request.resource.data.quote.get('albumSheets', 0) is number
              && request.resource.data.quote.get('promo', '') is string
              && request.resource.data.quote.get('promo', '').size() <= 40
              && request.resource.data.quote.get('events', []) is list
              && request.resource.data.quote.get('events', []).size() <= 12
              && leadEventsOk(request.resource.data.quote.get('events', []))
           ));
      allow read, update, delete: if isAdmin();
    }

    // visitors may READ the site config; only you may write it.
    //
    // This document HAS to be world-readable: the public builder reads prices
    // and presets from it before anyone signs in, and the client, crew and
    // partner portals read contact and the delivery checklists. So it may only
    // ever hold things you would print on the website.
    //
    // It used to hold rather more than that — serviceRates and learnedRates
    // (what the studio actually quotes at, and the album cost per sheet), the
    // quotation terms and the editing deadline. The web API key ships in
    // firebase-config.js by design, so one URL read the studio's whole cost
    // basis. Those live in config/internal now; keep this document to the
    // seven public keys.
    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // the half of the config nobody outside the studio has any business seeing:
    // serviceRates, learnedRates, quoteTerms, editDueDays, festivals. The
    // default-deny match at the bottom already covers this, so the panel works
    // whether or not this block is published; it is written out so the split is
    // visible next to the document it was split from.
    match /config/internal {
      allow read, write: if isAdmin();
    }

    // quote-number counter — admin only
    match /config/counters {
      allow read, write: if isAdmin();
    }

    // the availability calendar's knobs: `full` (events per morning/evening
    // that make it red, default 5) and `override` (per date: m/e forced 'r'
    // blocked or 'o' open). Admin only — the Cloud Function that reads it
    // uses the admin SDK, which bypasses these rules. The default-deny match
    // at the bottom already covers this document; written out so the pair
    // sits next to what it configures.
    match /config/availability {
      allow read, write: if isAdmin();
    }

    // the availability calendar itself, one document per month
    // (availability/2026-10). Colours only — { days: { '12': { m:'y', e:'r' } } }
    // — never a count, never a name, which is why anyone who signed in with
    // an OTP may read it: the client, crew and partner pages all show the
    // same grid. Not public: the builder and the home page never load it.
    //
    // `get`, not `read`: the pages listen to ONE doc by month id
    // (onSnapshot(doc('availability', 'YYYY-MM'))), never a query, so a list
    // is nothing they need and nobody but the admin may enumerate the
    // months. And a verified phone, not merely `request.auth != null`: a
    // login with no phone_number claim is not one of our people (the OTP
    // sign-in is the only way in for clients, crew and partners), so it gets
    // nothing — a stranger holding the web API key cannot read this by
    // signing in some other way. isAdmin() stays in the OR because the
    // admin's email login carries no phone claim at all.
    //
    // Written only by the Cloud Function (admin SDK, which bypasses these
    // rules); the admin login may also write it for a repair, nobody else.
    match /availability/{month} {
      allow get:   if isAdmin() || clientPhone10() != '__none__';
      allow list:  if isAdmin();
      allow write: if isAdmin();
    }

    // packages: you get full access; a signed-in client may READ only the
    // packages saved under their own verified mobile number (any country code).
    //
    // B2B studio jobs are kept away from clients by CONSTRUCTION, not by an
    // extra clause here: the admin panel saves them with clientPhone == ''
    // (readForm), so a query for a real 10-digit number can never match one,
    // and the portal filters clientType !== 'studio' as well.
    //
    // Do NOT add `resource.data.get('clientType','direct') != 'studio'` to
    // this rule. For a LIST query Firestore must prove every condition from
    // the query's own filters; the portal filters on clientPhone only, so an
    // unprovable clientType condition makes the whole query fail and EVERY
    // client sees "we couldn't load your booking".
    //
    // The THIRD branch is the B2B partner portal (/studio/). It queries
    //   where('clientType','==','studio').where('studioId','==', <id>)
    // so both fields are pinned constants, and ownership is proven by
    // looking up that studio doc's phone10 against the caller's verified
    // number — AND the studio must still be active, so deactivating a
    // partner in the admin panel revokes its job access here too (both
    // get() calls hit the same doc, so Firestore dedupes them to one
    // read). Each branch of the OR stays provable from its own portal's
    // filters, so adding this one cannot break the client query above.
    match /packages/{pkgId} {
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.clientPhone == clientPhone10())
        || (request.auth != null
            && resource.data.clientType == 'studio'
            && resource.data.studioId is string
            && get(/databases/$(database)/documents/studios/$(resource.data.studioId))
                 .data.phone10 == clientPhone10()
            && get(/databases/$(database)/documents/studios/$(resource.data.studioId))
                 .data.active == true);
      allow write: if isAdmin();
    }

    // B2B partner studios — admin has full access; a signed-in partner may
    // READ its own studio doc (profile, negotiated rate card) through the
    // /studio/ portal: the portal queries
    //   where('phone10','==', <verified last-10>).where('active','==', true)
    // and both conditions below are proven straight from those filters.
    // Deactivating a studio in the admin panel therefore switches its
    // portal access off server-side too. Never writable by anyone but you.
    match /studios/{studioId} {
      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.phone10 == clientPhone10()
            && resource.data.active == true);
      allow write: if isAdmin();
    }

    // booking requests from a partner studio (Oct 2026). The /studio/ portal
    // adds one doc per request; it lands in the admin panel's B2B tab, where
    // you Accept it (the panel then creates a DRAFT studio job and writes its
    // id here as pkgId) or Decline it. A request is only ever a question: it
    // books nothing and carries no price, and no other rule reads this
    // collection, so nothing a partner writes here can open or change a job.
    //
    // create — the admin panel renders these docs and a Cloud Function
    // pushes the answer to the phone10 on them, so each condition closes
    // one way of abusing that:
    //   · a verified phone, with phone10 pinned to it. phone10 is who the
    //     answer is pushed to and what the read rule below matches on; left
    //     free, one partner could file requests in another's name.
    //   · the studio named must be the caller's own and still active —
    //     proven by looking that studio doc up, the same check the packages
    //     rule makes (both get() calls hit one doc, so Firestore dedupes
    //     them to one read). Deactivating a partner in the admin panel
    //     therefore stops its requests too.
    //   · keys pinned to the twelve the form sends, status 'new', createdAt
    //     the server's own time. So a partner cannot file a request that is
    //     already 'accepted', attach a pkgId or an adminNote, or back-date
    //     it (the panel sorts and dates the list by createdAt).
    //   · every field typed and capped, for the same reason as leads: the
    //     panel renders them. date is pinned to a real-looking YYYY-MM-DD
    //     (20xx, month 01–12, day 01–31 — the panel still checks it is a
    //     day that exists) and slot to the three values the calendar knows.
    //     venue, endClientName and notes are '' when blank; a missing one
    //     counts as blank.
    //   · items: at most 12, and EACH one a { service, qty } map — service
    //     a non-empty string of ≤ 80, qty a whole number 1–10 (the
    //     builder's MAX_QTY). Rules have no loops, but they can index, so
    //     reqItemAt(items, n) checks entry n when the list is long enough
    //     and passes when it is not; reqItemsOk calls it for 0…11, which
    //     covers every entry the 12-cap allows. Without this an entry could
    //     be any type and size (a 1 MB string, a nested map) and the panel
    //     renders them. The panel still treats each entry as untrusted when
    //     it builds the draft job — and the price always comes from the rate
    //     card held in the panel, never from anything written here.
    //
    //     Each entry has to be CHEAP to check. A rule may evaluate only 1000
    //     expressions per request, and the first version of reqItemOk spent
    //     so many per entry (a get() with a default, a type test and a
    //     bound for each of service and qty) that a request with eight or
    //     more distinct services ran out of budget and was refused whole —
    //     the partner saw a failed send for a perfectly valid form. The
    //     entry is now one hasOnly, one regex for the service (non-empty,
    //     ≤ 80 characters, newlines allowed: (?s)), one `is int` and one
    //     regex on the number printed as text, which is how a bound on an
    //     int is written without two comparisons. The key lookups are
    //     brackets, not get(): a missing key, a non-map entry or a service
    //     that is not a string is an error, and an error is a deny.
    //     reqItemsOk takes the list ONCE: passing request.resource.data.items
    //     into each of twelve calls re-evaluated it twelve times.
    //
    // read — the portal queries  where('phone10','==', <verified last-10>)
    // with no orderBy and sorts on the phone, so the == below is proven
    // straight from that filter (a rule on a LIST must be provable from the
    // query's own filters). Signed out, clientPhone10() is '__none__', which
    // no request can carry.
    //
    // delete — a partner may cancel a request you have not answered yet
    // (status still 'new'); once answered it is your record to keep or
    // clear. update — only you: the answer (status, answeredAt, adminNote,
    // pkgId) is yours alone, so a partner can never mark its own request
    // accepted. And only while the request is still 'new': an answer is
    // given once. If two of your devices answer the same request, the
    // second one's write (a late Accept after a Decline, say) is refused
    // whole instead of overwriting the first answer the partner was
    // already pushed. Nothing else updates an answered request — the
    // Answered list's Delete is a delete, still yours under isAdmin().
    match /studioRequests/{reqId} {
      function reqField(k) {
        return request.resource.data.get(k, '');
      }
      // one items entry: exactly { service, qty }, both typed and capped.
      // Read with brackets: `service` is a keyword in the rules language, so
      // i.service does not compile.
      function reqItemOk(i) {
        return i.keys().hasOnly(['service','qty'])
          && i['service'].matches('(?s)^.{1,80}$')
          && i['qty'] is int
          && string(i['qty']).matches('^([1-9]|10)$');
      }
      // several functions sent as ONE request (a wedding and its reception):
      // one doc per function, linked by groupId. All three keys or none; the
      // id is a Firestore auto-id, n is 2..6 and i is this doc's place in it.
      function reqGroupOk() {
        return !request.resource.data.keys().hasAny(['groupId','groupN','groupI'])
          || (request.resource.data.keys().hasAll(['groupId','groupN','groupI'])
              && request.resource.data.groupId is string
              && request.resource.data.groupId.matches('^[A-Za-z0-9]{20}$')
              && request.resource.data.groupN is int
              && request.resource.data.groupN >= 2
              && request.resource.data.groupN <= 6
              && request.resource.data.groupI is int
              && request.resource.data.groupI >= 0
              && request.resource.data.groupI < request.resource.data.groupN);
      }
      // entry n of list l, if there is one — a shorter list passes
      function reqItemAt(l, n) {
        return l.size() <= n || reqItemOk(l[n]);
      }
      // every entry the 12-cap allows
      function reqItemsOk(l) {
        return reqItemAt(l, 0)
          && reqItemAt(l, 1)
          && reqItemAt(l, 2)
          && reqItemAt(l, 3)
          && reqItemAt(l, 4)
          && reqItemAt(l, 5)
          && reqItemAt(l, 6)
          && reqItemAt(l, 7)
          && reqItemAt(l, 8)
          && reqItemAt(l, 9)
          && reqItemAt(l, 10)
          && reqItemAt(l, 11);
      }
      allow create: if request.auth != null
        && clientPhone10() != '__none__'
        && request.resource.data.keys().hasOnly(
             ['studioId','phone10','studioName','date','slot','title','venue',
              'endClientName','items','notes','status','createdAt',
              'groupId','groupN','groupI'])
        && reqGroupOk()
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.phone10 == clientPhone10()
        && request.resource.data.studioId is string
        && get(/databases/$(database)/documents/studios/$(request.resource.data.studioId))
             .data.phone10 == clientPhone10()
        && get(/databases/$(database)/documents/studios/$(request.resource.data.studioId))
             .data.active == true
        && request.resource.data.studioName is string
        && request.resource.data.studioName.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.slot in ['morning', 'evening', 'full']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && reqField('venue') is string
        && reqField('venue').size() <= 160
        && reqField('endClientName') is string
        && reqField('endClientName').size() <= 120
        && reqField('notes') is string
        && reqField('notes').size() <= 1000
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 12
        && reqItemsOk(request.resource.data.items);
      allow read: if isAdmin() || resource.data.phone10 == clientPhone10();
      allow delete: if isAdmin()
        || (resource.data.phone10 == clientPhone10()
            && resource.data.status == 'new');
      allow update: if isAdmin() && resource.data.status == 'new';
    }

    // studio spending — rent, gear, travel, crew salaries. Admin-only, like
    // every other money record. The default-deny match at the bottom already
    // covers this collection, so the panel works whether or not this block is
    // published; it is written out so nobody has to guess.
    match /expenses/{expId} {
      allow read, write: if isAdmin();
    }

    // hashed phone index — single-doc existence check before sending an OTP
    match /phoneIndex/{h} {
      allow get:   if true;
      allow list:  if false;    // never allow enumerating the whole index
      allow write: if isAdmin();
    }

    // team members — created and managed only by the admin (approving a crew
    // request just means the admin creates this doc). A signed-in crew member
    // reads their own card via  where('phone10','==', <their last-10>)  —
    // the rules engine only permits queries whose filter provably satisfies
    // the phone match, so nobody can enumerate the team (same proven pattern
    // as the packages/clientPhone rule above).
    match /team/{memberId} {
      allow read: if isAdmin() || resource.data.phone10 == clientPhone10();
      allow create, update, delete: if isAdmin();
    }

    // per-member per-event assignments (schedule + pay). A crew member can
    // read ONLY their own docs, and the only writes they can ever make on
    // their own doc are (1) confirming they've seen it and (2) ticking or
    // unticking "editing complete" — never pay, never dates, never anyone
    // else's.
    match /assignments/{assignId} {
      allow read: if isAdmin() || resource.data.memberPhone10 == clientPhone10();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.memberPhone10 == clientPhone10()
            && (
              (request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status','ackAt'])
               && request.resource.data.status == 'acknowledged'
               && request.resource.data.ackAt == request.time)
              || (request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['workDone','workDoneAt'])
                  && request.resource.data.workDone is bool
                  && request.resource.data.workDoneAt == request.time)
              // (3) proposing a fee for their own editing job. A PROPOSAL,
              // never the fee: pay.* is untouched by this branch, so the
              // number only becomes real when the admin agrees to it in the
              // panel. Capped and typed so nothing arbitrary or absurd can be
              // written, and the member can withdraw it by clearing the field.
              || (request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['payProposal'])
                  && (!('payProposal' in request.resource.data)
                      || (request.resource.data.payProposal.keys()
                            .hasOnly(['amount','at','note'])
                          && request.resource.data.payProposal.amount is number
                          && request.resource.data.payProposal.amount >= 0
                          && request.resource.data.payProposal.amount <= 2000000
                          && request.resource.data.payProposal.at == request.time
                          && (!('note' in request.resource.data.payProposal)
                              || (request.resource.data.payProposal.note is string
                                  && request.resource.data.payProposal.note.size() <= 200)))))
            ));
    }

    // post-production workflow, one document per booking that owes a film
    // (doc id IS the package id). Stage, deadline, drive link, footage volume,
    // the client's editing brief, the note thread and the audit trail.
    //
    // This is deliberately NOT on the package: packages/{id} is readable by
    // the client AND by the partner studio, and the thread on here is between
    // the studio and its editor.
    //
    // An editor assigned to the job may read it and add a note. Rules cannot
    // run a query, so the document carries `editors` — the last-10 digits of
    // everyone currently assigned to it, written by the admin panel on every
    // job write. The crew page queries
    //   where('editors','array-contains', <verified last-10>)
    // and the read condition below is provable straight from that filter, the
    // same way the client and partner queries prove theirs above.
    //
    // What an editor may change is exactly one thing: append ONE note. The
    // key list is pinned, the array must grow by exactly one entry, so
    // nothing can be deleted, and stage, deadline, driveLink, brief, editors
    // and audit stay admin-only.
    //
    // The count alone left the entry itself free. An assigned editor could
    // append a null, a string or a megabyte of text — and every other
    // editor's page and the panel's thread would then have to render it —
    // or rewrite an earlier note inside that same array (the studio's own
    // instructions, say) while still growing it by one. So the new last entry
    // is now pinned to a map of exactly the four string fields both writers
    // send (id, at, by, text — the crew page and the panel), each capped, and
    // everything before it must be the array the document already holds: a
    // slice of the new list from the start up to the old count, compared
    // with the old list. That makes the thread append-only for an editor.
    // What rules still cannot prove is WHO a note says it is from: `by` and
    // `at` are the editor's own words, only typed and capped here, which is
    // why the audit trail stays a separate, admin-write-only field.
    match /editingJobs/{pkgId} {
      // `in`, and nothing else. For a LIST query Firestore has to prove every
      // condition from the query's own filter, and the crew page filters with
      // array-contains — which it can match to `x in list`, but NOT to
      // `list.hasAny([x])` and not to an `is list` type check. The first
      // version used both, so the crew query was refused outright
      // (permission-denied) for every editor, whatever editors[] held. Same
      // trap as the clientType warning on packages above. A document with no
      // editors field makes `in` error, and an error is a deny — which is what
      // the `is list` guard was there for anyway.
      function myJob() {
        return request.auth != null
          && clientPhone10() in resource.data.editors;
      }
      function noteCount(d) {
        return ('comments' in d) && d.comments is list ? d.comments.size() : 0;
      }
      // one note: exactly { id, at, by, text }, all strings, all capped.
      // Brackets, so a missing key or a non-map entry is an error — a deny.
      function noteOk(n) {
        return n.keys().hasOnly(['id','at','by','text'])
          && n['id'] is string && n['id'].size() <= 40
          && n['at'] is string && n['at'].size() <= 40
          && n['by'] is string && n['by'].size() <= 80
          && n['text'] is string && n['text'].size() <= 1000;
      }
      function addsOneNote() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['comments','updatedAt'])
            && request.resource.data.comments is list
            && noteCount(request.resource.data) == noteCount(resource.data) + 1
            && noteCount(request.resource.data) <= 400
            && request.resource.data.updatedAt == request.time
            && noteOk(request.resource.data.comments[noteCount(resource.data)])
            // the first note has nothing before it (no comments field yet)
            && (noteCount(resource.data) == 0
                || request.resource.data.comments[0:noteCount(resource.data)]
                     == resource.data.comments);
      }
      allow read: if isAdmin() || myJob();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (myJob() && addsOneNote());
    }

    // join requests from the crew page — a collection that is only READ now.
    // One per signed-in account (doc id is the auth uid). The crew page
    // stopped sending them on 29 Sep 2026 (one sign-in for everyone: crew
    // come in through a team/ card the admin creates, not a request), and no
    // page, function or script writes here any more — only the admin panel
    // reads, approves and dismisses the ones already sitting in it, and
    // deleteMyAccount clears the caller's own with the admin SDK. create
    // used to be open to ANY signed-in account with a verified phone, so a
    // stranger holding the web API key could fill the panel's Crew tab with
    // requests it renders. Nothing legitimate needs that door, so it is
    // shut: `if false`, not a tighter condition. The requester can still
    // re-read their own request to see it pending.
    // (If a join form ever comes back, this is the rule to reopen — with the
    // fields pinned and capped, status 'pending', phone10 == clientPhone10().)
    //
    // Re-opened 6 Oct 2026 with the open sign-in: a signed-in number the studio
    // has not set up may ask to join the crew. One request per login (the doc
    // id IS the uid), pending only, bounded fields. It grants nothing: the
    // owner approves it by creating the team doc, and only then does the crew
    // page open for that number.
    match /teamRequests/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && clientPhone10() != '__none__'
        && request.resource.data.keys().hasOnly(
             ['name','note','phone10','phoneFull','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.phone10 == clientPhone10()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.phoneFull is string
        && request.resource.data.phoneFull.size() <= 20;
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, update, delete: if isAdmin();
    }

    // who has signed in without being set up (6 Oct 2026, open sign-in): one
    // doc per login, keyed by the uid, written by the person from the Welcome
    // screen so the owner can see them and follow up. Nothing here grants
    // anything — it is a list for the admin. `action` only records what they
    // did there. The person may not read or delete it; deleteMyAccount clears it.
    match /signups/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && clientPhone10() != '__none__'
        && request.resource.data.keys().hasOnly(['phone10','phoneFull','action','createdAt','lastAt'])
        && request.resource.data.phone10 == clientPhone10()
        && request.resource.data.phoneFull is string
        && request.resource.data.phoneFull.size() <= 20
        && request.resource.data.action in ['seen','lead','crew','partner']
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['action','lastAt'])
        && request.resource.data.action in ['seen','lead','crew','partner']
        && request.resource.data.lastAt == request.time;
      allow read, delete: if isAdmin();
    }

    // a partner studio asking to be added (6 Oct 2026): the same shape of
    // rule — one per login, pending only, bounded. Approving it means the
    // owner adds the studio (studios/{id} with this phone10); only then does
    // the partner page open. The person may withdraw their own request.
    match /partnerRequests/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && clientPhone10() != '__none__'
        && request.resource.data.keys().hasOnly(
             ['studioName','ownerName','city','note','phone10','phoneFull','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.phone10 == clientPhone10()
        && request.resource.data.studioName is string
        && request.resource.data.studioName.size() > 0
        && request.resource.data.studioName.size() <= 120
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.phoneFull is string
        && request.resource.data.phoneFull.size() <= 20;
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // push-notification tokens from the store app. The doc id IS the FCM
    // token; a signed-in client (or crew/partner — anyone with a verified
    // phone) may save or remove a token pinned to their own last-10, with
    // the fields locked down so nothing else can ride along. Only the
    // admin (and the Cloud Function, which uses the admin SDK and bypasses
    // rules) can read them — tokens are capability handles, never public.
    match /pushTokens/{token} {
      allow create, update: if request.auth != null
        && clientPhone10() != '__none__'
        && request.resource.data.keys().hasOnly(['phone10','platform','updatedAt'])
        && request.resource.data.phone10 == clientPhone10()
        && request.resource.data.platform in ['ios','android','app']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.phone10 == clientPhone10());
      allow read: if isAdmin();
    }

    // the person's own profile (one sign-in, Sep 2026): name, photo, and a
    // few details for the roles the admin set their number up as — crew: an
    // emergency contact; client: an email; partner: studio name, owner name,
    // city. The doc id IS the auth uid. Pages read it with a plain get of
    // profiles/<their uid>, never a query, so the read rule needs nothing
    // from a filter; the admin panel lists them all to join on phone10.
    //
    // This card grants NOTHING. What a person may see is still decided by the
    // admin's own records (packages / team / studios, above), and no rule
    // anywhere reads profiles — writing roles.crew here opens no crew page.
    //
    // phone10 is pinned to the OTP-verified number because the admin panel
    // joins on it: a free phone10 would let a stranger hang their photo and
    // name on someone else's team card or booking. Everything else is pinned
    // and capped for the same reason as leads: the admin panel renders it.
    //
    // The profile step is optional ("Later"), so every field except uid and
    // phone10 may be missing, and null counts as not given; when a field is
    // there it must have its type and fit its cap. The photo is a JPEG data
    // URL made on the phone (256 px, so far under the cap): only the base64
    // alphabet may follow the prefix, so nothing in it can break out of the
    // <img src> it lands in on the panel.
    match /profiles/{uid} {
      // the doc id is passed in rather than read from the enclosing match,
      // so nothing here leans on how function scope sees path wildcards
      function mine(id) {
        return request.auth != null && request.auth.uid == id;
      }
      function pf(k) {
        return request.resource.data.get(k, null);
      }
      function optStr(v, cap) {
        return v == null || (v is string && v.size() <= cap);
      }
      function optTime(v) {
        return v == null || v is timestamp;
      }
      // the panel picks the newest card per phone10 by updatedAt and prints
      // "updated <date>", so every write stamps it with the server clock
      // (serverTimestamp()) — a phone cannot back- or future-date it.
      // laterAt ("Later" was tapped) is either stamped the same way or left
      // exactly as it is: no write may set it to another time or clear it.
      function stampsOk() {
        return (pf('updatedAt') == null || pf('updatedAt') == request.time)
          && (!('laterAt' in request.resource.data.diff(
                 resource == null ? {} : resource.data).affectedKeys())
              || pf('laterAt') == request.time);
      }
      function photoOk(p) {
        return p == null || p == ''
          || (p is string
              && p.size() <= 160000
              && p.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+=*'));
      }
      function crewOk(m) {
        return m is map
          && m.keys().hasOnly(['emergencyName','emergencyPhone'])
          && optStr(m.get('emergencyName', null), 80)
          && optStr(m.get('emergencyPhone', null), 20);
      }
      function clientOk(m) {
        return m is map
          && m.keys().hasOnly(['email'])
          && optStr(m.get('email', null), 120);
      }
      function studioOk(m) {
        return m is map
          && m.keys().hasOnly(['studioName','ownerName','city'])
          && optStr(m.get('studioName', null), 80)
          && optStr(m.get('ownerName', null), 80)
          && optStr(m.get('city', null), 60);
      }
      function rolesOk(r) {
        return r == null
          || (r is map
              && r.keys().hasOnly(['crew','client','studio'])
              && (!('crew' in r) || crewOk(r.crew))
              && (!('client' in r) || clientOk(r.client))
              && (!('studio' in r) || studioOk(r.studio)));
      }
      function profileOk(id) {
        return mine(id)
          && clientPhone10() != '__none__'
          && request.resource.data.keys().hasOnly(
               ['uid','phone10','name','photo','roles','laterAt','updatedAt'])
          && request.resource.data.uid == id
          && request.resource.data.phone10 == clientPhone10()
          && optStr(pf('name'), 80)
          && photoOk(pf('photo'))
          && rolesOk(pf('roles'))
          && optTime(pf('laterAt'))
          && optTime(pf('updatedAt'))
          && stampsOk();
      }
      allow read: if isAdmin() || mine(uid);
      allow create, update: if profileOk(uid);
      allow delete: if mine(uid);
    }

    // "Delete my account" leaves one note here so the studio knows the person
    // asked. Only the deleteMyAccount Cloud Function writes it, with the admin
    // SDK, which bypasses these rules — one per login (doc id is the uid),
    // created once, never rewritten. This rule used to double as a fallback
    // that let the page leave the note itself when the function could not be
    // reached; no page does that any more (fs-auth.js just calls the
    // function), so create was open to any signed-in account for nothing: a
    // stranger could file account-deletion notes under their own uid for the
    // panel's Home to list and date. It is shut — `if false`. Only you read
    // and clear them.
    match /deletionRequests/{uid} {
      allow create: if false;
      allow read, delete: if isAdmin();
    }

    // PORTFOLIO (6 Oct 2026). The owner uploads photos, videos and reels from
    // admin/portfolio/; every login he approves sees the same set.
    //
    // portfolioRequests/{uid} — one ask per login (the doc id IS the uid),
    // pending only, bounded. It grants nothing by itself: the owner flips
    // status to 'approved' (or 'declined'), and only an approved doc opens
    // portfolio/. The person may read their own request (to see the answer)
    // but never change it, so nobody can approve themselves.
    match /portfolioRequests/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && clientPhone10() != '__none__'
        && request.resource.data.keys().hasOnly(
             ['name','phone10','phoneFull','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.phone10 == clientPhone10()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.phoneFull is string
        && request.resource.data.phoneFull.size() <= 20;
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, update, delete: if isAdmin();
    }

    // portfolio/{id} — the showcase items. Read: the owner, or a login whose
    // own request is approved. The condition depends on the caller only, not
    // on a field of the queried docs, so a plain ordered list query proves it.
    // Write: the owner alone. kind is photo | video | reel; url / thumb are
    // Firebase Storage download links written by the admin page.
    match /portfolio/{itemId} {
      allow read: if isAdmin()
        || (request.auth != null
            && exists(/databases/$(database)/documents/portfolioRequests/$(request.auth.uid))
            && get(/databases/$(database)/documents/portfolioRequests/$(request.auth.uid)).data.status == 'approved');
      allow write: if isAdmin();
    }

    // everything else (incl. legacy lenscal_* data): admin only — default deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
