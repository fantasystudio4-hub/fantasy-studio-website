#!/bin/sh
# Runs before every commit: lint (errors only), type-check, format check, tests.
# Enabled by `npm install` (the prepare script sets core.hooksPath=.githooks).
# Skip once in an emergency with: git commit --no-verify
[ -d "$HOME/.local/node/bin" ] && PATH="$HOME/.local/node/bin:$PATH"
command -v npm >/dev/null 2>&1 || { echo "pre-commit: npm not found — install Node, then npm install"; exit 1; }
[ -d node_modules ] || { echo "pre-commit: run 'npm install' first"; exit 1; }
exec npm run --silent check
